data/*
!data/.gitkeep
.venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
*.duckdb
# customer-level derived data stays local (event-confidential)
outputs/*.csv
outputs/report_data.json
outputs/readout.html
runs/**/out/
runs/**/*.parquet
runs/**/*.csv

# event Q&A recordings stay local
sources/qa/

# per-home / per-transformer prototype outputs stay local
outputs/private/
outputs/demo/*.html
runs/**/*.npy

# video and deck media stay out of git
outputs/video/
outputs/**/*.mp4
outputs/**/*.wav
outputs/**/*.m4a
outputs/**/*.pptx

# bench figures: some draw single real homes (fig2_signatures, fig6_dispatch_example); new ones stay local
runs/**/*.png
